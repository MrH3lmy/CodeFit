{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codefit:original-only:1",
  "title": "Original-only developer catalog metadata, not a production import",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "sourceKind", "permittedRelease", "books", "units", "skills"],
  "properties": {
    "schema": {"const": "codefit-original-only/1"},
    "revision": {"$ref": "#/$defs/id"},
    "sourceKind": {"const": "ORIGINAL_ONLY"},
    "permittedRelease": {"$ref": "#/$defs/release"},
    "books": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/book"}},
    "units": {"type": "array", "minItems": 5, "maxItems": 100, "items": {"$ref": "#/$defs/unit"}},
    "skills": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/skill"}}
  },
  "$defs": {
    "id": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "stageId": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[.-][A-Za-z0-9]+)*$"},
    "release": {"const": "METADATA_ONLY"},
    "coverage": {"enum": ["UNREPORTED", "AUTHOR_REPORTED"]},
    "book": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/id"}}
    },
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "bookId", "coverage", "skillIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "bookId": {"$ref": "#/$defs/id"},
        "coverage": {"$ref": "#/$defs/coverage"},
        "skillIds": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "bookId", "unitId", "mappingStatus", "prerequisites", "stages"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "bookId": {"$ref": "#/$defs/id"}, "unitId": {"$ref": "#/$defs/id"},
        "mappingStatus": {"const": "UNMAPPED"},
        "prerequisites": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "stages": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/stage"}}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["status", "history"],
      "properties": {
        "status": {"enum": ["UNREVIEWED", "REVIEW_PENDING", "UNSUPPORTED"]},
        "history": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "UNREVIEWED"}}}, "then": {"properties": {"history": {"const": ["UNREVIEWED"]}}}},
        {"if": {"properties": {"status": {"const": "REVIEW_PENDING"}}}, "then": {"properties": {"history": {"const": ["UNREVIEWED", "REVIEW_PENDING"]}}}},
        {"if": {"properties": {"status": {"const": "UNSUPPORTED"}}}, "then": {"properties": {"history": {"const": ["UNREVIEWED", "UNSUPPORTED"]}}}}
      ]
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["revision", "technical", "pedagogical"],
      "properties": {
        "revision": {"$ref": "#/$defs/id"},
        "technical": {"$ref": "#/$defs/decision"},
        "pedagogical": {"$ref": "#/$defs/decision"}
      }
    },
    "brief": {
      "type": "object", "additionalProperties": false, "required": ["status", "text"],
      "properties": {
        "status": {"enum": ["ABSENT", "UNSUPPORTED", "ORIGINAL_AUTHOR_DRAFT"]},
        "text": {"type": "string", "maxLength": 256}
      },
      "if": {"properties": {"status": {"const": "ORIGINAL_AUTHOR_DRAFT"}}},
      "then": {"properties": {"text": {"pattern": "^[A-Za-z0-9][A-Za-z0-9 ,;()'!?-]{0,255}$"}}},
      "else": {"properties": {"text": {"const": ""}}}
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "bookId", "unitId", "skillId", "stage", "status", "coverage", "brief", "independentReview", "permittedRelease"],
      "properties": {
        "id": {"$ref": "#/$defs/stageId"}, "bookId": {"$ref": "#/$defs/id"},
        "unitId": {"$ref": "#/$defs/id"}, "skillId": {"$ref": "#/$defs/id"},
        "stage": {"enum": ["PREDICT", "DEBUG", "BUILD", "DEFEND"]},
        "status": {"enum": ["ABSENT", "UNSUPPORTED", "UNREVIEWED", "REVIEW_PENDING"]},
        "coverage": {"$ref": "#/$defs/coverage"},
        "brief": {"$ref": "#/$defs/brief"},
        "independentReview": {"$ref": "#/$defs/review"},
        "permittedRelease": {"$ref": "#/$defs/release"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ABSENT"}}},
          "then": {"properties": {
            "coverage": {"const": "UNREPORTED"},
            "brief": {"properties": {"status": {"const": "ABSENT"}}},
            "independentReview": {"properties": {
              "technical": {"properties": {"status": {"const": "UNREVIEWED"}}},
              "pedagogical": {"properties": {"status": {"const": "UNREVIEWED"}}}
            }}
          }}
        },
        {
          "if": {"properties": {"status": {"const": "UNSUPPORTED"}}},
          "then": {"properties": {
            "coverage": {"const": "UNREPORTED"},
            "brief": {"properties": {"status": {"const": "UNSUPPORTED"}}},
            "independentReview": {"properties": {
              "technical": {"properties": {"status": {"const": "UNSUPPORTED"}}},
              "pedagogical": {"properties": {"status": {"const": "UNSUPPORTED"}}}
            }}
          }}
        },
        {
          "if": {"properties": {"status": {"enum": ["UNREVIEWED", "REVIEW_PENDING"]}}},
          "then": {"properties": {
            "coverage": {"const": "AUTHOR_REPORTED"},
            "brief": {"properties": {"status": {"const": "ORIGINAL_AUTHOR_DRAFT"}}},
            "independentReview": {"properties": {
              "technical": {"properties": {"status": {"enum": ["UNREVIEWED", "REVIEW_PENDING"]}}},
              "pedagogical": {"properties": {"status": {"enum": ["UNREVIEWED", "REVIEW_PENDING"]}}}
            }}
          }}
        },
        {
          "if": {"properties": {"status": {"const": "UNREVIEWED"}}},
          "then": {"properties": {"independentReview": {"properties": {
            "technical": {"properties": {"status": {"const": "UNREVIEWED"}}},
            "pedagogical": {"properties": {"status": {"const": "UNREVIEWED"}}}
          }}}}
        },
        {
          "if": {"properties": {"status": {"const": "REVIEW_PENDING"}}},
          "then": {"properties": {"independentReview": {"anyOf": [
            {"properties": {"technical": {"properties": {"status": {"const": "REVIEW_PENDING"}}}}},
            {"properties": {"pedagogical": {"properties": {"status": {"const": "REVIEW_PENDING"}}}}}
          ]}}}
        }
      ]
    }
  }
}
