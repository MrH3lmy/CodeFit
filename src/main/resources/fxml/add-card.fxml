<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.codefit.ui.Sidebar?>

<BorderPane styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.AddCardController">
    <left>
        <Sidebar activePage="add-card" />
    </left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
            <content>
                <VBox spacing="18" styleClass="content" maxWidth="Infinity">
                    <VBox spacing="8" styleClass="page-header" maxWidth="Infinity">
                        <Label text="Add Flashcard" styleClass="page-title" wrapText="true" />
                        <Label text="Build a stronger learning set one card at a time: capture the prompt, add the answer, and file it into the right deck." styleClass="page-subtitle" wrapText="true" />
                    </VBox>
                    <Label fx:id="messageLabel" styleClass="status-banner" wrapText="true" visible="false" managed="false" />
                    <VBox spacing="14" styleClass="panel" maxWidth="Infinity">
                        <Label text="Deck" styleClass="section-title" />
                        <ComboBox fx:id="deckComboBox" maxWidth="Infinity" />
                        <Button fx:id="createDeckButton" text="Create a Deck" onAction="#goDecks" styleClass="nav-button-primary" visible="false" managed="false" />
                        <Label text="Prompt" styleClass="section-title" />
                        <TextArea fx:id="frontArea" promptText="Question, code snippet, or concept" prefRowCount="6" wrapText="true" />
                        <Label text="Answer" styleClass="section-title" />
                        <TextArea fx:id="backArea" promptText="Answer, explanation, or expected output" prefRowCount="8" wrapText="true" />
                        <Button fx:id="saveCardButton" text="Save Card" onAction="#saveCard" styleClass="action-button" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
