<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.codefit.ui.Sidebar?>
<BorderPane fx:id="shellRoot" styleClass="app-root,app-shell" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.ui.AppShellController">
    <left><Sidebar fx:id="sidebar" /></left>
    <center>
        <VBox minWidth="0">
            <HBox fx:id="topBar" styleClass="app-topbar" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3" minWidth="0" HBox.hgrow="ALWAYS">
                    <Label text="THE SYSTEM / WORKSPACE" styleClass="system-eyebrow" />
                    <Label fx:id="topBarTitleLabel" styleClass="topbar-title" wrapText="true" />
                </VBox>
                <Button text="+ New Card" onAction="#openNewCard" styleClass="ghost-button" minWidth="-Infinity" />
            </HBox>
            <StackPane fx:id="contentHost" styleClass="content-host" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>
</BorderPane>
