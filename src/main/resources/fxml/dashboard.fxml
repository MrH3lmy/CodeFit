<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.DashboardController">
    <content>
        <VBox alignment="TOP_CENTER" maxWidth="Infinity" spacing="16" styleClass="content" VBox.vgrow="ALWAYS">
            <VBox maxWidth="Infinity" spacing="4" styleClass="page-header">
                <Label text="Today" styleClass="page-title" wrapText="true" />
            </VBox>

            <Label fx:id="contextBannerLabel" styleClass="status-banner" wrapText="true" visible="false" managed="false" />

            <VBox maxWidth="Infinity" spacing="18" styleClass="dashboard-card dashboard-learning-hero">
                <VBox alignment="CENTER_LEFT" spacing="6" maxWidth="Infinity">
                    <Label fx:id="nextActionTitleLabel" text="Review due cards" styleClass="dashboard-hero-title" wrapText="true" />
                    <Label fx:id="nextActionHelperLabel" text="Start with the cards that need attention now." styleClass="dashboard-card-helper dashboard-hero-helper" wrapText="true" />
                    <Label fx:id="streakQuestStatusLabel" styleClass="dashboard-card-helper" wrapText="true" />
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="18" styleClass="dashboard-hero-action-row">
                    <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="dueCountLabel" styleClass="dashboard-card-value accent due-value" wrapText="true" />
                        <Label text="Ready for review" styleClass="dashboard-card-helper" wrapText="true" />
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="8">
                        <HBox alignment="CENTER_RIGHT" spacing="8">
                            <Button fx:id="primaryActionButton" text="Start Review" onAction="#goReview" styleClass="primary-button quick-review-button dashboard-primary-cta" />
                            <MenuButton fx:id="reviewSessionMenuButton" text="Session options" styleClass="ghost-button">
                                <items>
                                    <MenuItem text="Quick session (5 min)" onAction="#startQuickSession" />
                                    <MenuItem text="Standard session (15 min)" onAction="#startStandardSession" />
                                    <MenuItem text="Deep session (30 min)" onAction="#startDeepSession" />
                                </items>
                            </MenuButton>
                        </HBox>
                        <Button fx:id="weeklyBossButton" text="Weekly Boss Battle" onAction="#goWeeklyBossBattle" styleClass="ghost-button" visible="false" managed="false" />
                    </VBox>
                </HBox>
            </VBox>

            <VBox maxWidth="Infinity" spacing="12" styleClass="dashboard-card">
                <Label text="NEEDS ATTENTION" styleClass="dashboard-card-title" wrapText="true" />
                <VBox fx:id="weakSkillsList" maxWidth="Infinity" spacing="10" />
            </VBox>

            <VBox maxWidth="Infinity" spacing="8" styleClass="dashboard-card">
                <Label text="ACTIVE FOCUS" styleClass="dashboard-card-title" wrapText="true" />
                <Label fx:id="focusExplainerLabel" styleClass="dashboard-card-helper" wrapText="true" />
                <Label fx:id="focusRecommendationLabel" styleClass="status-banner" wrapText="true" visible="false" managed="false" />
                <Button text="Manage Focus" onAction="#goSyllabus" styleClass="ghost-button" minWidth="0" />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
