<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.codefit.ui.Sidebar?>

<BorderPane styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.DashboardController">
    <left>
        <Sidebar activePage="dashboard" />
    </left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
            <content>
                <VBox spacing="24" styleClass="content" maxWidth="Infinity">
                    <Label text="Dashboard" styleClass="page-title" wrapText="true" />
                    <Label fx:id="emptyStateLabel" styleClass="status-banner" wrapText="true" visible="false" managed="false" />
                    <TilePane hgap="18" vgap="18" prefTileWidth="220" tileAlignment="TOP_LEFT">
                        <VBox styleClass="stat-card" minWidth="0" maxWidth="Infinity">
                            <Label text="RANK" styleClass="stat-label" />
                            <Label fx:id="levelLabel" styleClass="stat-value" wrapText="true" />
                            <ProgressBar fx:id="levelProgressBar" maxWidth="Infinity" />
                            <Label fx:id="xpLabel" styleClass="muted" wrapText="true" />
                        </VBox>
                        <VBox styleClass="stat-card" minWidth="0" maxWidth="Infinity">
                            <Label text="STREAK" styleClass="stat-label" />
                            <Label fx:id="streakLabel" styleClass="stat-value" wrapText="true" />
                            <Label text="Keep daily reviews alive to maintain your combo." styleClass="muted" wrapText="true" />
                        </VBox>
                        <VBox styleClass="stat-card" minWidth="0" maxWidth="Infinity">
                            <Label text="DUE REVIEWS" styleClass="stat-label" />
                            <Label fx:id="dueCountLabel" styleClass="stat-value accent" wrapText="true" />
                            <Button text="Start Review" onAction="#goReview" styleClass="action-button" maxWidth="Infinity" />
                        </VBox>
                    </TilePane>
                    <TilePane hgap="18" vgap="18" prefTileWidth="220" tileAlignment="TOP_LEFT">
                        <VBox styleClass="small-card" minWidth="0" maxWidth="Infinity">
                            <Label text="Decks" styleClass="stat-label" />
                            <Label fx:id="deckCountLabel" styleClass="stat-value" wrapText="true" />
                        </VBox>
                        <VBox styleClass="small-card" minWidth="0" maxWidth="Infinity">
                            <Label text="Cards" styleClass="stat-label" />
                            <Label fx:id="cardCountLabel" styleClass="stat-value" wrapText="true" />
                        </VBox>
                    </TilePane>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <padding><Insets top="0" right="0" bottom="0" left="0" /></padding>
</BorderPane>
