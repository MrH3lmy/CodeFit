<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.DashboardController">
    <left>
        <VBox styleClass="sidebar" spacing="12">
            <Label text="CodeFit" styleClass="brand" />
            <Button text="Dashboard" onAction="#goDashboard" styleClass="nav-button-primary" />
            <Button text="Decks" onAction="#goDecks" styleClass="nav-button" />
            <Button text="Add Card" onAction="#goAddCard" styleClass="nav-button" />
            <Button text="Review" onAction="#goReview" styleClass="nav-button" />
            <Button text="Stats" onAction="#goStats" styleClass="nav-button" />
        </VBox>
    </left>
    <center>
        <VBox spacing="24" styleClass="content">
            <Label text="Mission Control" styleClass="page-title" />
            <Label fx:id="emptyStateLabel" styleClass="status-banner" />
            <GridPane hgap="18" vgap="18">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33" />
                    <ColumnConstraints percentWidth="33" />
                    <ColumnConstraints percentWidth="34" />
                </columnConstraints>
                <VBox styleClass="stat-card" GridPane.columnIndex="0">
                    <Label text="RANK" styleClass="stat-label" />
                    <Label fx:id="levelLabel" styleClass="stat-value" />
                    <ProgressBar fx:id="levelProgressBar" maxWidth="Infinity" />
                    <Label fx:id="xpLabel" styleClass="muted" />
                </VBox>
                <VBox styleClass="stat-card" GridPane.columnIndex="1">
                    <Label text="STREAK" styleClass="stat-label" />
                    <Label fx:id="streakLabel" styleClass="stat-value" />
                    <Label text="Keep daily reviews alive to maintain your combo." styleClass="muted" wrapText="true" />
                </VBox>
                <VBox styleClass="stat-card" GridPane.columnIndex="2">
                    <Label text="DUE REVIEWS" styleClass="stat-label" />
                    <Label fx:id="dueCountLabel" styleClass="stat-value accent" />
                    <Button text="Start Review" onAction="#goReview" styleClass="action-button" />
                </VBox>
            </GridPane>
            <HBox spacing="18">
                <VBox styleClass="small-card" HBox.hgrow="ALWAYS">
                    <Label text="Decks" styleClass="stat-label" />
                    <Label fx:id="deckCountLabel" styleClass="stat-value" />
                </VBox>
                <VBox styleClass="small-card" HBox.hgrow="ALWAYS">
                    <Label text="Cards" styleClass="stat-label" />
                    <Label fx:id="cardCountLabel" styleClass="stat-value" />
                </VBox>
            </HBox>
        </VBox>
    </center>
    <padding><Insets top="0" right="0" bottom="0" left="0" /></padding>
</BorderPane>
