<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.codefit.ui.Sidebar?>

<BorderPane styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.DashboardController">
    <left>
        <Sidebar activePage="dashboard" />
    </left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
            <content>
                <VBox spacing="24" styleClass="content" maxWidth="Infinity">
                    <VBox spacing="12" styleClass="page-header" maxWidth="Infinity">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Dashboard" styleClass="page-title" wrapText="true" HBox.hgrow="ALWAYS" />
                            <Label text="Daily focus" styleClass="header-pill" wrapText="true" />
                        </HBox>
                        <Label text="Keep your learning streak moving with a quick look at rank, cards due, and deck momentum." styleClass="page-subtitle" wrapText="true" />
                    </VBox>
                    <Label fx:id="emptyStateLabel" styleClass="status-banner" wrapText="true" visible="false" managed="false" />
                    <TilePane hgap="18" vgap="18" prefColumns="3" prefTileWidth="220" tileAlignment="TOP_LEFT" styleClass="card-tile-grid">
                        <VBox styleClass="stat-card cyan-card" minWidth="0" maxWidth="Infinity">
                            <Label text="🏆 RANK" styleClass="stat-label" />
                            <Label fx:id="levelLabel" styleClass="stat-value" wrapText="true" />
                            <ProgressBar fx:id="levelProgressBar" maxWidth="Infinity" />
                            <Label text="XP progress fills in as you complete reviews." styleClass="muted" wrapText="true" />
                            <Label fx:id="xpLabel" styleClass="muted" wrapText="true" />
                        </VBox>
                        <VBox styleClass="stat-card green-card" minWidth="0" maxWidth="Infinity">
                            <Label text="🔥 STREAK" styleClass="stat-label" />
                            <Label fx:id="streakLabel" styleClass="stat-value" wrapText="true" />
                            <Label text="Keep daily reviews alive to maintain your combo." styleClass="muted" wrapText="true" />
                        </VBox>
                        <VBox styleClass="stat-card violet-card" minWidth="0" maxWidth="Infinity">
                            <Label text="⚡ DUE REVIEWS" styleClass="stat-label" />
                            <Label fx:id="dueCountLabel" styleClass="stat-value accent" wrapText="true" />
                            <Label text="No rush—this queue updates when cards are ready." styleClass="muted" wrapText="true" />
                            <Button text="Start Review" onAction="#goReview" styleClass="action-button" maxWidth="Infinity" />
                        </VBox>
                    </TilePane>
                    <TilePane hgap="18" vgap="18" prefColumns="2" prefTileWidth="220" tileAlignment="TOP_LEFT" styleClass="card-tile-grid">
                        <VBox styleClass="small-card amber-card" minWidth="0" maxWidth="Infinity">
                            <Label text="📚 DECKS" styleClass="stat-label" />
                            <Label fx:id="deckCountLabel" styleClass="stat-value" wrapText="true" />
                            <Label text="Create focused decks to organize your practice." styleClass="muted" wrapText="true" />
                        </VBox>
                        <VBox styleClass="small-card cyan-card" minWidth="0" maxWidth="Infinity">
                            <Label text="🧠 CARDS" styleClass="stat-label" />
                            <Label fx:id="cardCountLabel" styleClass="stat-value" wrapText="true" />
                            <Label text="Add prompts gradually; even one card starts momentum." styleClass="muted" wrapText="true" />
                        </VBox>
                    </TilePane>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <padding><Insets top="0" right="0" bottom="0" left="0" /></padding>
</BorderPane>
