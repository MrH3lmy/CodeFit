<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.codefit.ui.Sidebar?>

<BorderPane styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.DashboardController">
    <left>
        <Sidebar activePage="dashboard" />
    </left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
            <content>
                <VBox alignment="TOP_CENTER" maxWidth="Infinity" spacing="16" styleClass="content" VBox.vgrow="ALWAYS">
                    <VBox maxWidth="Infinity" spacing="12" styleClass="page-header">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Dashboard" styleClass="page-title" wrapText="true" HBox.hgrow="ALWAYS" />
                            <Label text="Daily focus" styleClass="pill" wrapText="true" />
                        </HBox>
                        <Label text="Keep your learning streak moving with a quick look at rank, cards due, and deck momentum." styleClass="page-subtitle" wrapText="true" />
                    </VBox>

                    <Label fx:id="emptyStateLabel" styleClass="status-banner" wrapText="true" visible="false" managed="false" />
                    <Label fx:id="systemMessageLabel" styleClass="status-banner" wrapText="true" visible="false" managed="false" />

                    <VBox maxWidth="Infinity" spacing="18" styleClass="dashboard-card dashboard-learning-hero">
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <VBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS">
                                <Label text="NEXT BEST ACTION" styleClass="dashboard-card-title" wrapText="true" />
                                <Label fx:id="nextActionTitleLabel" text="Review due cards" styleClass="dashboard-hero-title" wrapText="true" />
                                <Label fx:id="nextActionHelperLabel" text="Start with the cards that need attention now, then build or browse your library after the review queue is clear." styleClass="dashboard-card-helper dashboard-hero-helper" wrapText="true" />
                            </VBox>
                            <VBox alignment="CENTER_RIGHT" spacing="4" styleClass="dashboard-streak-signal">
                                <Label text="STREAK" styleClass="dashboard-card-title" wrapText="true" />
                                <Label fx:id="streakLabel" text="1 day" styleClass="dashboard-card-value streak-value" wrapText="true" />
                            </VBox>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="dashboard-hero-action-row">
                            <VBox alignment="CENTER_LEFT" spacing="10" styleClass="due-signal" HBox.hgrow="ALWAYS">
                                <VBox alignment="CENTER_LEFT" spacing="4">
                                    <Label text="DUE NOW" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="dueCountLabel" styleClass="dashboard-card-value accent due-value" wrapText="true" />
                                    <Label text="Ready for review" styleClass="dashboard-card-helper" wrapText="true" />
                                    <Label fx:id="workloadModeLabel" text="Normal · up to 10 review cards" styleClass="pill" wrapText="true" />
                                </VBox>
                                <VBox alignment="CENTER_LEFT" spacing="5" maxWidth="Infinity">
                                    <Label fx:id="dailyQuestTitleLabel" text="Daily quest: review due cards" styleClass="dashboard-card-title" wrapText="true" />
                                    <ProgressBar fx:id="dailyQuestProgressBar" maxWidth="Infinity" styleClass="level-progress" />
                                    <Label fx:id="dailyQuestProgressLabel" text="0 / 5 • 25 XP" styleClass="dashboard-card-helper" wrapText="true" />
                                </VBox>
                            </VBox>
                            <VBox alignment="CENTER_RIGHT" spacing="10" styleClass="dashboard-action-stack">
                                <Button fx:id="primaryActionButton" text="Start Review" onAction="#goReview" maxWidth="Infinity" styleClass="primary-button quick-review-button dashboard-primary-cta" />
                                <HBox alignment="CENTER_RIGHT" spacing="8" styleClass="dashboard-timed-session-row">
                                    <Label text="Timed session:" styleClass="dashboard-card-helper" wrapText="true" />
                                    <Button text="Quick (5m)" onAction="#goReviewQuick" styleClass="ghost-button secondary-action-button" />
                                    <Button text="Standard (15m)" onAction="#goReviewStandard" styleClass="ghost-button secondary-action-button" />
                                    <Button text="Deep (30m)" onAction="#goReviewDeep" styleClass="ghost-button secondary-action-button" />
                                </HBox>
                                <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="dashboard-secondary-actions">
                                    <Button text="Add Card" onAction="#goAddCard" styleClass="ghost-button secondary-action-button" />
                                    <Button text="View Decks" onAction="#goDecks" styleClass="ghost-button secondary-action-button" />
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="14" styleClass="dashboard-signal-strip">
                        <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                            <Label text="RANK" styleClass="dashboard-card-title" wrapText="true" />
                            <Label fx:id="levelLabel" text="Level 1" styleClass="dashboard-signal-value" wrapText="true" />
                        </VBox>
                        <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                            <Label text="DECKS" styleClass="dashboard-card-title" wrapText="true" />
                            <Label fx:id="deckCountLabel" text="3" styleClass="dashboard-signal-value" wrapText="true" />
                        </VBox>
                        <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                            <Label text="CARDS" styleClass="dashboard-card-title" wrapText="true" />
                            <Label fx:id="cardCountLabel" text="9" styleClass="dashboard-signal-value" wrapText="true" />
                        </VBox>
                    </HBox>


                    <VBox maxWidth="Infinity" spacing="12" styleClass="dashboard-card daily-routine-card">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox alignment="CENTER_LEFT" spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="DAILY ROUTINE" styleClass="dashboard-card-title" wrapText="true" />
                                <Label text="Move through today’s essentials using your review history, due queue, weak-area signal, and quest state." styleClass="dashboard-card-helper" wrapText="true" />
                            </VBox>
                            <Button text="Open Review" onAction="#goReview" styleClass="ghost-button" />
                        </HBox>
                        <VBox fx:id="dailyRoutineList" maxWidth="Infinity" spacing="10" />
                    </VBox>

                    <GridPane hgap="14" maxWidth="Infinity" vgap="14" styleClass="dashboard-bottom-grid">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="58" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="42" />
                        </columnConstraints>
                        <VBox maxWidth="Infinity" minWidth="0" spacing="12" styleClass="dashboard-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="XP PROGRESS" styleClass="dashboard-card-title" wrapText="true" />
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label text="Next Level" styleClass="dashboard-card-value dashboard-card-value-medium" wrapText="true" HBox.hgrow="ALWAYS" />
                                <Label fx:id="xpLabel" text="15 / 50 XP" styleClass="xp-chip" wrapText="true" />
                            </HBox>
                            <ProgressBar fx:id="levelProgressBar" maxWidth="Infinity" styleClass="level-progress" />
                            <Label text="Complete reviews to fill the bar and unlock the next level." styleClass="dashboard-card-helper" wrapText="true" />
                        </VBox>
                        <VBox maxWidth="Infinity" minWidth="0" spacing="12" styleClass="dashboard-card recent-decks-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label text="RECENT DECKS" styleClass="dashboard-card-title" wrapText="true" HBox.hgrow="ALWAYS" />
                                <Button text="View all decks" onAction="#goDecks" styleClass="ghost-button" />
                            </HBox>
                            <VBox fx:id="recentDecksList" maxWidth="Infinity" spacing="10" VBox.vgrow="ALWAYS" />
                        </VBox>
                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <padding><Insets top="0" right="0" bottom="0" left="0" /></padding>
</BorderPane>
