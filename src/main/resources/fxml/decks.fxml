<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.DecksController">
    <content>
                <VBox spacing="18" styleClass="content" maxWidth="Infinity">
                    <VBox spacing="8" styleClass="page-header" maxWidth="Infinity">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Library" styleClass="page-title" wrapText="true" HBox.hgrow="ALWAYS" />
                            <Button text="Syllabus" onAction="#goSyllabus" styleClass="ghost-button" />
                            <Button fx:id="newDeckToggleButton" text="+ New Deck" onAction="#toggleCreateDeckPanel" styleClass="primary-button" />
                        </HBox>
                        <Label text="Search, filter, and organize related prompts into focused decks so each review queue matches what you want to master next." styleClass="page-subtitle" wrapText="true" />
                    </VBox>
                    <Label fx:id="messageLabel" styleClass="status-banner" wrapText="true" visible="false" managed="false" />

                    <HBox spacing="10" alignment="CENTER_LEFT" maxWidth="Infinity">
                        <TextField fx:id="searchField" promptText="Search decks and cards…" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                        <ToggleButton fx:id="deckFilterAllButton" text="All" styleClass="ghost-button" selected="true" />
                        <ToggleButton fx:id="deckFilterDueButton" text="Due" styleClass="ghost-button" />
                        <ToggleButton fx:id="deckFilterMasteredButton" text="Mastered" styleClass="ghost-button" />
                    </HBox>

                    <FlowPane hgap="22" vgap="22" prefWrapLength="720" styleClass="workspace-grid" VBox.vgrow="ALWAYS" maxWidth="Infinity">
                        <VBox spacing="18" styleClass="primary-column" minWidth="0" prefWidth="460" maxWidth="Infinity">
                            <VBox spacing="10" styleClass="panel deck-list-panel" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                                <Label text="Decks" styleClass="section-title" />
                                <Label fx:id="deckEmptyGuidanceLabel" styleClass="muted" wrapText="true" visible="false" managed="false" />
                                <ListView fx:id="deckListView" prefHeight="260" VBox.vgrow="ALWAYS" />
                            </VBox>
                            <VBox spacing="10" styleClass="panel card-list-panel" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Cards" styleClass="section-title" HBox.hgrow="ALWAYS" />
                                    <Button text="Import Cards" onAction="#importCards" styleClass="ghost-button" />
                                    <Button text="Export Cards" onAction="#exportCards" styleClass="ghost-button" />
                                </HBox>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <ToggleButton fx:id="cardFilterAllButton" text="All" styleClass="ghost-button" selected="true" />
                                    <ToggleButton fx:id="cardFilterDueButton" text="Due" styleClass="ghost-button" />
                                    <ToggleButton fx:id="cardFilterMasteredButton" text="Mastered" styleClass="ghost-button" />
                                    <ToggleButton fx:id="cardFilterSuspendedButton" text="Suspended" styleClass="ghost-button" />
                                </HBox>
                                <Label fx:id="cardEmptyGuidanceLabel" styleClass="muted" wrapText="true" visible="false" managed="false" />
                                <ListView fx:id="cardListView" prefHeight="260" VBox.vgrow="ALWAYS" />
                            </VBox>
                        </VBox>
                        <VBox fx:id="createDeckPanel" spacing="14" styleClass="panel side-panel" minWidth="0" prefWidth="280" maxWidth="Infinity" visible="false" managed="false">
                            <Label text="Create Deck" styleClass="section-title" />
                            <TextField fx:id="deckNameField" promptText="Deck name" maxWidth="Infinity" />
                            <TextArea fx:id="deckDescriptionArea" promptText="Description" prefRowCount="8" wrapText="true" maxWidth="Infinity" VBox.vgrow="ALWAYS" />
                            <Button text="Create Deck" onAction="#createDeck" styleClass="action-button" maxWidth="Infinity" />
                            <Button text="Create Java BE Path" onAction="#createJavaBackendPath" maxWidth="Infinity" />
                        </VBox>
                    </FlowPane>
                </VBox>
    </content>
</ScrollPane>
