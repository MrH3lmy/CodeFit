<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.DecksController">
    <left>
        <VBox styleClass="sidebar" spacing="12">
            <Label text="CodeFit" styleClass="brand" />
            <Button text="Dashboard" onAction="#goDashboard" styleClass="nav-button" />
            <Button text="Decks" onAction="#goDecks" styleClass="nav-button-primary" />
            <Button text="Add Card" onAction="#goAddCard" styleClass="nav-button" />
            <Button text="Review" onAction="#goReview" styleClass="nav-button" />
            <Button text="Stats" onAction="#goStats" styleClass="nav-button" />
        </VBox>
    </left>
    <center>
        <VBox spacing="18" styleClass="content">
            <Label text="Deck Arsenal" styleClass="page-title" />
            <Label fx:id="messageLabel" styleClass="status-banner" />
            <HBox spacing="18" VBox.vgrow="ALWAYS">
                <VBox spacing="10" styleClass="panel" HBox.hgrow="ALWAYS">
                    <Label text="Decks" styleClass="section-title" />
                    <ListView fx:id="deckListView" VBox.vgrow="ALWAYS" />
                </VBox>
                <VBox spacing="10" styleClass="panel" HBox.hgrow="ALWAYS">
                    <Label text="Cards" styleClass="section-title" />
                    <ListView fx:id="cardListView" VBox.vgrow="ALWAYS" />
                </VBox>
                <VBox spacing="10" styleClass="panel" prefWidth="300">
                    <Label text="Create Deck" styleClass="section-title" />
                    <TextField fx:id="deckNameField" promptText="Deck name" />
                    <TextArea fx:id="deckDescriptionArea" promptText="Description" prefRowCount="6" wrapText="true" />
                    <Button text="Create Deck" onAction="#createDeck" styleClass="action-button" />
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
