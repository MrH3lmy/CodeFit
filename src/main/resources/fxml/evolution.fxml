<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.EvolutionController" styleClass="evolution" spacing="16">
  <HBox spacing="12" alignment="CENTER_LEFT">
    <VBox spacing="4" HBox.hgrow="ALWAYS">
      <Label text="PLAYER SYSTEM" styleClass="evolution-eyebrow"/>
      <Label text="Build ability. Understand the evidence." styleClass="evolution-title" wrapText="true"/>
      <Label text="Java Debugging &amp; Concurrency · local and offline" styleClass="evolution-muted"/>
    </VBox>
    <Button fx:id="refreshButton" text="Refresh" onAction="#refresh" accessibleText="Refresh current estimates and recommendation"/>
  </HBox>
  <HBox spacing="10" alignment="CENTER_LEFT">
    <ProgressIndicator fx:id="loading" prefWidth="22" prefHeight="22" visible="false" managed="false"/>
    <Label fx:id="statusLabel" text="Loading your local learning state…" wrapText="true" HBox.hgrow="ALWAYS"/>
    <Button fx:id="retryButton" text="Retry same operation" onAction="#retry" visible="false" managed="false"/>
    <Button fx:id="cancelButton" text="Cancel execution" onAction="#cancel" visible="false" managed="false"/>
  </HBox>
  <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
    <tabs>
      <Tab text="Overview" fx:id="overviewTab"><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox fx:id="overviewBox" spacing="16" styleClass="evolution-page"/></ScrollPane></Tab>
      <Tab text="Skills" fx:id="skillsTab"><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox fx:id="skillsBox" spacing="14" styleClass="evolution-page"/></ScrollPane></Tab>
      <Tab text="Diagnostics" fx:id="baselineTab"><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox fx:id="baselineBox" spacing="14" styleClass="evolution-page"/></ScrollPane></Tab>
      <Tab text="Challenge" fx:id="challengeTab">
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox fx:id="challengeBox" spacing="12" styleClass="evolution-page">
          <Label fx:id="challengeTitle" text="Your next engineering challenge" styleClass="evolution-heading" wrapText="true"/>
          <Label fx:id="runnerNotice" text="Local Java runner — not a sandbox. Execute only your own local code. Checks cover a limited set of solution forms; a passing stress test does not prove universal thread safety." wrapText="true" styleClass="evolution-muted"/>
          <Label fx:id="exposureLabel" text="Accept a quest or start a diagnostic. Exposure is saved before content is shown." wrapText="true" styleClass="evolution-muted"/>
          <TextArea fx:id="promptArea" editable="false" wrapText="true" prefRowCount="9" accessibleText="Authorized challenge instructions"/>
          <Label text="Your solution / diagnostic response" styleClass="evolution-heading"/>
          <TextArea fx:id="sourceArea" prefRowCount="15" styleClass="evolution-editor" accessibleText="Editable local solution; use Tab to move between controls"/>
          <Label fx:id="draftLabel" text="No challenge open" styleClass="evolution-muted"/>
          <Label text="Reflection (retained, not automatically graded)"/>
          <TextArea fx:id="reflectionArea" wrapText="true" prefRowCount="3" accessibleText="Ungraded explanation of your approach"/>
          <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Outside help"/><ComboBox fx:id="assistanceBox" accessibleText="Declare outside assistance; unknown does not establish independence"/></HBox>
          <FlowPane fx:id="challengeActions" hgap="8" vgap="8"/>
          <VBox fx:id="feedbackBox" spacing="10"/>
        </VBox></ScrollPane>
      </Tab>
      <Tab text="Journal" fx:id="journalTab"><ScrollPane fitToWidth="true" hbarPolicy="NEVER"><VBox fx:id="journalBox" spacing="12" styleClass="evolution-page"/></ScrollPane></Tab>
    </tabs>
  </TabPane>
</VBox>
