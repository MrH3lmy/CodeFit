<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" stylesheets="@../css/interview.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.codefit.controller.InterviewMockController">
    <content>
        <VBox alignment="TOP_CENTER" maxWidth="Infinity" spacing="16" styleClass="content" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Mock Interview" styleClass="page-title" />
                    <Label text="Run the generated interview, then score every observable behavior. Blank rubric fields are never treated as zero." styleClass="page-subtitle" wrapText="true" />
                </VBox>
                <Button text="Back to Interview" onAction="#backToInterviewDashboard" styleClass="ghost-button" />
            </HBox>

            <VBox maxWidth="Infinity" spacing="12" styleClass="dashboard-card">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="MOCK MODE" styleClass="dashboard-card-title" />
                        <ComboBox fx:id="modeComboBox" prefWidth="260" />
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="4">
                        <Label text="TARGET" styleClass="dashboard-card-title" />
                        <Label fx:id="totalTargetLabel" text="165 min target · 4 stages" styleClass="interview-stage-title" />
                    </VBox>
                </HBox>
            </VBox>

            <Label fx:id="resultLabel" styleClass="status-banner" wrapText="true" visible="false" managed="false" />

            <VBox fx:id="stagesContainer" maxWidth="Infinity" spacing="14" />

            <VBox maxWidth="Infinity" spacing="8" styleClass="dashboard-card">
                <Label text="RUN NOTES" styleClass="dashboard-card-title" />
                <Label text="Capture interviewer feedback, recurring misses, or context worth reviewing later." styleClass="dashboard-card-helper" wrapText="true" />
                <TextArea fx:id="notesArea" promptText="Optional notes..." prefRowCount="4" wrapText="true" />
            </VBox>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Reset Scores" onAction="#resetMock" styleClass="ghost-button" />
                <Button fx:id="completeButton" text="Save Mock Result" onAction="#completeMock" styleClass="primary-button interview-primary-cta" />
            </HBox>
        </VBox>
    </content>
</ScrollPane>
