<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.ProblemDashboardController">
    <content>
        <VBox spacing="18" styleClass="content" maxWidth="Infinity">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="&#8249; Problems" onAction="#goProblems" styleClass="ghost-button" />
            </HBox>

            <VBox spacing="4" styleClass="page-header" maxWidth="Infinity">
                <Label text="Problem-Solving Dashboard" styleClass="page-title" wrapText="true" />
                <Label text="Every figure below is computed from your saved attempts and progress — nothing here is a separate counter." styleClass="page-subtitle" wrapText="true" />
            </VBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <MenuButton fx:id="stageFilterMenuButton" text="Stage: All" styleClass="ghost-button" />
                <MenuButton fx:id="dateRangeFilterMenuButton" text="Range: All time" styleClass="ghost-button" />
                <Button text="Clear Filters" onAction="#clearFilters" styleClass="ghost-button" />
            </HBox>

            <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                <Label text="Recommended Next" styleClass="section-title" />
                <Label fx:id="recommendationLabel" styleClass="problem-row-title" wrapText="true" />
                <Label fx:id="recommendationReasonLabel" styleClass="dashboard-card-helper" wrapText="true" />
                <Button fx:id="recommendationResumeButton" text="Start / Resume" onAction="#resumeRecommended" styleClass="action-button" />
            </VBox>

            <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                <Label text="Core Progress" styleClass="section-title" />
                <Label fx:id="currentStageLabel" styleClass="problem-row-title" wrapText="true" />
                <HBox spacing="16">
                    <VBox spacing="2">
                        <Label text="Mandatory" styleClass="dashboard-card-helper" />
                        <Label fx:id="mandatoryProgressLabel" styleClass="problem-row-subtitle" />
                    </VBox>
                    <VBox spacing="2">
                        <Label text="Optional" styleClass="dashboard-card-helper" />
                        <Label fx:id="optionalProgressLabel" styleClass="problem-row-subtitle" />
                    </VBox>
                    <VBox spacing="2">
                        <Label text="This week" styleClass="dashboard-card-helper" />
                        <Label fx:id="solvedThisWeekLabel" styleClass="problem-row-subtitle" />
                    </VBox>
                </HBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="acCountLabel" styleClass="pill, pill-state-solved" />
                    <Label fx:id="acxCountLabel" styleClass="pill, pill-state-solved" />
                    <Label fx:id="couldNotSolveCountLabel" styleClass="pill, pill-state-needs-revisit" />
                    <Label fx:id="inProgressCountLabel" styleClass="pill, pill-state-in-progress" />
                    <Label fx:id="notStartedCountLabel" styleClass="pill, pill-state-not-started" />
                </HBox>

                <Label text="By stage" styleClass="dashboard-card-helper" />
                <VBox fx:id="stageBreakdownBox" spacing="6" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                <Label text="Quality Metrics" styleClass="section-title" />
                <Label fx:id="firstSubmissionAccuracyLabel" styleClass="dashboard-card-helper" wrapText="true" />
                <Label fx:id="independentSolveRateLabel" styleClass="dashboard-card-helper" wrapText="true" />
                <Label fx:id="editorialDependencyRateLabel" styleClass="dashboard-card-helper" wrapText="true" />
                <Label fx:id="averageSubmissionsLabel" styleClass="dashboard-card-helper" wrapText="true" />
                <Label fx:id="averagePerceivedDifficultyLabel" styleClass="dashboard-card-helper" wrapText="true" />
                <Label fx:id="mandatoryCompletionLabel" styleClass="dashboard-card-helper" wrapText="true" />
                <Label fx:id="optionalCompletionLabel" styleClass="dashboard-card-helper" wrapText="true" />
            </VBox>

            <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                <Label text="Timing Insights" styleClass="section-title" />
                <Label text="Every second here already excludes paused time." styleClass="muted" wrapText="true" />
                <HBox spacing="18">
                    <VBox spacing="2" alignment="CENTER">
                        <Label text="Reading" styleClass="dashboard-card-helper" />
                        <Label fx:id="avgReadingLabel" styleClass="problem-row-subtitle" />
                    </VBox>
                    <VBox spacing="2" alignment="CENTER">
                        <Label text="Thinking" styleClass="dashboard-card-helper" />
                        <Label fx:id="avgThinkingLabel" styleClass="problem-row-subtitle" />
                    </VBox>
                    <VBox spacing="2" alignment="CENTER">
                        <Label text="Coding" styleClass="dashboard-card-helper" />
                        <Label fx:id="avgCodingLabel" styleClass="problem-row-subtitle" />
                    </VBox>
                    <VBox spacing="2" alignment="CENTER">
                        <Label text="Debugging" styleClass="dashboard-card-helper" />
                        <Label fx:id="avgDebuggingLabel" styleClass="problem-row-subtitle" />
                    </VBox>
                </HBox>
                <Label fx:id="totalSolvingTimeLabel" styleClass="dashboard-card-helper" wrapText="true" />
                <Label fx:id="bottleneckLabel" styleClass="dashboard-card-helper" wrapText="true" />
            </VBox>

            <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                <Label text="Topic Insights" styleClass="section-title" />
                <Label fx:id="topicInsightsEmptyLabel" styleClass="dashboard-card-helper" wrapText="true" managed="false" visible="false" />
                <VBox fx:id="topicInsightsBox" spacing="8" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                <Label text="Overdue Reflections" styleClass="section-title" />
                <Label text="Solved problems with no post-solve reflection recorded yet, oldest first." styleClass="muted" wrapText="true" />
                <Label fx:id="reflectionGapsEmptyLabel" styleClass="dashboard-card-helper" wrapText="true" managed="false" visible="false" />
                <VBox fx:id="reflectionGapsBox" spacing="6" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                <Label text="Unfinished Attempts" styleClass="section-title" />
                <Label text="Workspace sessions that were started but never finished or abandoned, stalest first." styleClass="muted" wrapText="true" />
                <Label fx:id="unfinishedAttemptsEmptyLabel" styleClass="dashboard-card-helper" wrapText="true" managed="false" visible="false" />
                <VBox fx:id="unfinishedAttemptsBox" spacing="6" maxWidth="Infinity" />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
