<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.ProblemSolvingWorkspaceController">
    <content>
        <VBox spacing="18" styleClass="content" maxWidth="Infinity">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="&#8249; Problems" onAction="#goProblems" styleClass="ghost-button" />
            </HBox>

            <VBox spacing="4" styleClass="page-header" maxWidth="Infinity">
                <Label fx:id="titleLabel" text="Solving Workspace" styleClass="page-title" wrapText="true" />
                <Label fx:id="subtitleLabel" styleClass="page-subtitle" wrapText="true" />
            </VBox>

            <Label fx:id="messageLabel" styleClass="status-banner" wrapText="true" visible="false" managed="false" />
            <Label fx:id="checkpointBanner" styleClass="status-banner, checkpoint-banner" wrapText="true" visible="false" managed="false" />

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="progressStateLabel" styleClass="pill" />
                <Button text="Open Problem ↗" onAction="#openProblem" styleClass="ghost-button" />
            </HBox>

            <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                <Label text="Timer" styleClass="section-title" />
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <VBox spacing="2">
                        <Label text="Current phase" styleClass="dashboard-card-helper" />
                        <Label fx:id="currentPhaseLabel" styleClass="problem-row-title" />
                    </VBox>
                    <VBox spacing="2">
                        <Label text="Total elapsed" styleClass="dashboard-card-helper" />
                        <Label fx:id="totalElapsedLabel" styleClass="problem-row-title" />
                    </VBox>
                </HBox>

                <HBox spacing="18">
                    <VBox spacing="2" alignment="CENTER">
                        <Label text="Reading" styleClass="dashboard-card-helper" />
                        <Label fx:id="readingTimeLabel" styleClass="problem-row-subtitle" />
                    </VBox>
                    <VBox spacing="2" alignment="CENTER">
                        <Label text="Thinking" styleClass="dashboard-card-helper" />
                        <Label fx:id="thinkingTimeLabel" styleClass="problem-row-subtitle" />
                    </VBox>
                    <VBox spacing="2" alignment="CENTER">
                        <Label text="Coding" styleClass="dashboard-card-helper" />
                        <Label fx:id="codingTimeLabel" styleClass="problem-row-subtitle" />
                    </VBox>
                    <VBox spacing="2" alignment="CENTER">
                        <Label text="Debugging" styleClass="dashboard-card-helper" />
                        <Label fx:id="debuggingTimeLabel" styleClass="problem-row-subtitle" />
                    </VBox>
                </HBox>

                <Label text="Phase" styleClass="dashboard-card-helper" />
                <HBox spacing="8">
                    <Button fx:id="readingPhaseButton" text="Reading" onAction="#switchToReading" styleClass="ghost-button" />
                    <Button fx:id="thinkingPhaseButton" text="Thinking" onAction="#switchToThinking" styleClass="ghost-button" />
                    <Button fx:id="codingPhaseButton" text="Coding" onAction="#switchToCoding" styleClass="ghost-button" />
                    <Button fx:id="debuggingPhaseButton" text="Debugging" onAction="#switchToDebugging" styleClass="ghost-button" />
                </HBox>

                <HBox spacing="8">
                    <Button fx:id="startButton" text="Start" onAction="#startSession" styleClass="primary-button" />
                    <Button fx:id="pauseButton" text="Pause" onAction="#pauseSession" styleClass="ghost-button" />
                    <Button fx:id="resumeButton" text="Resume" onAction="#resumeSession" styleClass="primary-button" />
                    <Button fx:id="resetButton" text="Reset" onAction="#resetSession" styleClass="ghost-button" />
                </HBox>
            </VBox>

            <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                <Label text="Hints" styleClass="section-title" />
                <Label fx:id="prerequisitesLabel" wrapText="true" styleClass="muted" visible="false" managed="false" />
                <Label fx:id="referenceLinksLabel" wrapText="true" styleClass="muted" visible="false" managed="false" />
                <VBox fx:id="revealedHintsBox" spacing="8" maxWidth="Infinity" />
                <Label fx:id="hintsExhaustedLabel" text="No more hints — you're at the full explanation." styleClass="muted" wrapText="true" visible="false" managed="false" />
                <HBox spacing="8">
                    <Button fx:id="revealHintButton" text="Reveal Next Hint" onAction="#revealNextHint" styleClass="action-button" />
                    <Button text="Edit Guidance" onAction="#toggleGuidanceEditor" styleClass="ghost-button" />
                </HBox>
                <VBox fx:id="guidanceEditorBox" spacing="6" maxWidth="Infinity" visible="false" managed="false">
                    <Label text="Clarify" styleClass="problem-row-subtitle" />
                    <TextArea fx:id="clarifyEditArea" wrapText="true" prefRowCount="2" maxWidth="Infinity" />
                    <Label text="Observation" styleClass="problem-row-subtitle" />
                    <TextArea fx:id="observationEditArea" wrapText="true" prefRowCount="2" maxWidth="Infinity" />
                    <Label text="Approach" styleClass="problem-row-subtitle" />
                    <TextArea fx:id="approachEditArea" wrapText="true" prefRowCount="2" maxWidth="Infinity" />
                    <Label text="Explanation" styleClass="problem-row-subtitle" />
                    <TextArea fx:id="explanationEditArea" wrapText="true" prefRowCount="3" maxWidth="Infinity" />
                    <Button text="Save Guidance" onAction="#saveGuidanceEdits" styleClass="action-button" />
                </VBox>
            </VBox>

            <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                <Label text="Finish" styleClass="section-title" />
                <Label text="Submitted / Could Not Solve record the verdict picked below; Accepted always records AC." styleClass="muted" wrapText="true" />
                <MenuButton fx:id="verdictMenuButton" text="Verdict: AC" styleClass="ghost-button" />
                <TextArea fx:id="notesArea" promptText="Optional notes for this attempt…" prefRowCount="3" wrapText="true" maxWidth="Infinity" />
                <HBox spacing="8">
                    <Button text="Mark Submitted" onAction="#finishAsSubmitted" styleClass="action-button" />
                    <Button text="Mark Accepted" onAction="#finishAsAccepted" styleClass="action-button" />
                    <Button text="Could Not Solve" onAction="#finishAsCouldNotSolve" styleClass="ghost-button" />
                    <Button text="Abandon" onAction="#finishAsAbandoned" styleClass="ghost-button" />
                </HBox>
                <Button text="Mark Previously Solved (ACX)…" onAction="#markPreviouslySolved" styleClass="ghost-button" />
            </VBox>

            <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                <Label text="Post-Solve Reflection" styleClass="section-title" />
                <Label text="All optional; save any time and edit again later." styleClass="muted" wrapText="true" />

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Perceived difficulty" styleClass="dashboard-card-helper" />
                    <MenuButton fx:id="difficultyRatingMenuButton" text="Not rated" styleClass="ghost-button" />
                    <Label text="Solved with" styleClass="dashboard-card-helper" />
                    <MenuButton fx:id="solvedWithMenuButton" text="Not set" styleClass="ghost-button" />
                    <Label text="Final category" styleClass="dashboard-card-helper" />
                    <MenuButton fx:id="finalCategoryMenuButton" text="Not set" styleClass="ghost-button" />
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Time complexity" styleClass="dashboard-card-helper" />
                    <MenuButton fx:id="timeComplexityMenuButton" text="Not set" styleClass="ghost-button" />
                    <Label text="Space complexity" styleClass="dashboard-card-helper" />
                    <MenuButton fx:id="spaceComplexityMenuButton" text="Not set" styleClass="ghost-button" />
                </HBox>

                <TextField fx:id="actualTopicField" promptText="Actual category/topic used (e.g. Two Pointers)" maxWidth="Infinity" />
                <TextArea fx:id="approachNotesArea" promptText="Approach summary…" prefRowCount="2" wrapText="true" maxWidth="Infinity" />
                <TextArea fx:id="mistakeNotesArea" promptText="Mistake made…" prefRowCount="2" wrapText="true" maxWidth="Infinity" />
                <TextArea fx:id="importantObservationArea" promptText="Important observation…" prefRowCount="2" wrapText="true" maxWidth="Infinity" />
                <TextArea fx:id="lessonLearnedArea" promptText="Lesson learned…" prefRowCount="2" wrapText="true" maxWidth="Infinity" />

                <Label text="After AC" styleClass="dashboard-card-helper" />
                <CheckBox fx:id="editorialUnderstoodCheckBox" text="Editorial understood" />
                <CheckBox fx:id="otherSolutionsReviewedCheckBox" text="Other accepted solutions reviewed" />
                <CheckBox fx:id="simplerImplementationCheckBox" text="Simpler implementation considered" />
                <CheckBox fx:id="betterComplexityCheckBox" text="Better complexity considered" />

                <Button text="Save Reflection" onAction="#saveReflection" styleClass="primary-button" />
            </VBox>

            <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                <Label text="Create Flashcard" styleClass="section-title" />
                <Label text="Turn a reflection field into a flashcard without retyping it." styleClass="muted" wrapText="true" />

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="From" styleClass="dashboard-card-helper" />
                    <MenuButton fx:id="flashcardSourceMenuButton" text="Lesson Learned" styleClass="ghost-button" />
                    <Button text="Generate Draft" onAction="#generateFlashcardDraft" styleClass="ghost-button" />
                </HBox>

                <Label fx:id="flashcardDraftEmptyLabel" text="Pick a reflection field and click Generate Draft." styleClass="dashboard-card-helper" wrapText="true" />

                <VBox fx:id="flashcardDraftBox" spacing="10" maxWidth="Infinity" visible="false" managed="false">
                    <TextField fx:id="flashcardFrontField" promptText="Card prompt…" maxWidth="Infinity" />
                    <TextArea fx:id="flashcardBackArea" promptText="Card answer…" prefRowCount="3" wrapText="true" maxWidth="Infinity" />
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Deck" styleClass="dashboard-card-helper" />
                        <MenuButton fx:id="flashcardDeckMenuButton" text="Problem-Solving Lessons" styleClass="ghost-button" />
                    </HBox>
                    <Button text="Save Flashcard" onAction="#saveFlashcard" styleClass="primary-button" />
                </VBox>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
