<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.codefit.ui.Sidebar?>

<BorderPane styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.ReviewController">
    <left>
        <Sidebar activePage="review" />
    </left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
            <content>
                <VBox spacing="18" styleClass="content" maxWidth="Infinity">
                    <VBox spacing="12" styleClass="hero-card" maxWidth="Infinity">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Review Queue" styleClass="page-title" wrapText="true" HBox.hgrow="ALWAYS" />
                            <Label fx:id="queueLabel" styleClass="header-pill" wrapText="true" />
                        </HBox>
                        <Label text="Clear today&apos;s queue, reinforce the cards that need attention, and turn each rating into smarter progress." styleClass="page-subtitle" wrapText="true" />
                    </VBox>
                    <Label fx:id="messageLabel" styleClass="status-banner" wrapText="true" visible="false" managed="false" />
                    <VBox spacing="20" styleClass="review-card" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                        <Label text="PROMPT" styleClass="stat-label" />
                        <Label fx:id="promptLabel" styleClass="review-prompt" wrapText="true" />
                        <Separator />
                        <Label text="ANSWER" styleClass="stat-label" />
                        <Label fx:id="answerLabel" styleClass="review-answer" wrapText="true" />
                        <Button fx:id="showAnswerButton" text="Reveal Answer" onAction="#showAnswer" styleClass="action-button" />
                        <TilePane hgap="12" vgap="12" prefTileWidth="120" tileAlignment="TOP_LEFT">
                            <Button fx:id="againButton" text="Again" onAction="#rateAgain" styleClass="danger-button" maxWidth="Infinity" />
                            <Button fx:id="hardButton" text="Hard" onAction="#rateHard" styleClass="warning-button" maxWidth="Infinity" />
                            <Button fx:id="goodButton" text="Good" onAction="#rateGood" styleClass="success-button" maxWidth="Infinity" />
                            <Button fx:id="easyButton" text="Easy" onAction="#rateEasy" styleClass="epic-button" maxWidth="Infinity" />
                        </TilePane>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
