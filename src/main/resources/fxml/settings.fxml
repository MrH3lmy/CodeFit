<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.SettingsController">
    <content>
        <VBox spacing="18" styleClass="content" maxWidth="Infinity">
            <VBox spacing="4" styleClass="page-header" maxWidth="Infinity">
                <Label text="Settings" styleClass="page-title" wrapText="true" />
            </VBox>

            <VBox spacing="8" styleClass="panel" maxWidth="Infinity">
                <Label text="Appearance" styleClass="section-title" />
                <Label text="Choose the interface theme used across CodeFit." styleClass="muted" wrapText="true" />
                <ChoiceBox fx:id="themeChoiceBox" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="8" styleClass="panel" maxWidth="Infinity">
                <Label text="Daily Training Intensity" styleClass="section-title" />
                <Label text="Choose how much CodeFit should plan for today's quests and review-session queue." styleClass="muted" wrapText="true" />
                <ChoiceBox fx:id="workloadModeChoiceBox" maxWidth="Infinity" />
                <Label fx:id="workloadModeDetailLabel" styleClass="dashboard-card-helper" wrapText="true" />
            </VBox>

            <VBox spacing="8" styleClass="panel" maxWidth="Infinity">
                <Label text="Mature-Card Interleaving" styleClass="section-title" />
                <Label text="Share of leftover session time reserved for mature cards from modules outside your active focus, so older material doesn't rot." styleClass="muted" wrapText="true" />
                <ChoiceBox fx:id="matureInterleavePercentChoiceBox" maxWidth="Infinity" />
                <Label fx:id="matureInterleavePercentDetailLabel" styleClass="dashboard-card-helper" wrapText="true" />
            </VBox>

            <VBox spacing="8" styleClass="panel" maxWidth="Infinity">
                <Label text="Guided Daily Routine" styleClass="section-title" />
                <Label text="Session length and new-card cap for &quot;Start Today's Training&quot; on the dashboard — change the routine here instead of building a queue by hand." styleClass="muted" wrapText="true" />
                <Label text="Session length" styleClass="dashboard-card-helper" />
                <ChoiceBox fx:id="guidedSessionMinutesChoiceBox" maxWidth="Infinity" />
                <Label text="New cards per day" styleClass="dashboard-card-helper" />
                <ChoiceBox fx:id="dailyNewCardLimitChoiceBox" maxWidth="Infinity" />
                <Label fx:id="guidedRoutineDetailLabel" styleClass="dashboard-card-helper" wrapText="true" />
            </VBox>

            <VBox spacing="8" styleClass="panel" maxWidth="Infinity">
                <Label text="Problem-Solving Training" styleClass="section-title" />
                <Label text="Import a local Junior Training Sheet-style workbook (.xlsx) to build your problem roadmap. Re-importing the same file is always safe: it never creates duplicates and never overwrites progress you've already recorded." styleClass="muted" wrapText="true" />
                <Label text="This workbook stays entirely on your machine — CodeFit never uploads it or its contents anywhere. You are responsible for having the right to use whatever workbook you import; do not import copyrighted third-party curricula without permission." styleClass="muted" wrapText="true" />

                <Label text="Source attribution (optional, but recommended for anything not your own)" styleClass="dashboard-card-helper" />
                <TextField fx:id="importSourceNameField" promptText="Source name (defaults to the file name)" maxWidth="Infinity" />
                <TextField fx:id="importSourceUrlField" promptText="Source URL" maxWidth="Infinity" />
                <TextField fx:id="importAuthorField" promptText="Author" maxWidth="Infinity" />
                <TextField fx:id="importVersionField" promptText="Version" maxWidth="Infinity" />
                <Button fx:id="importTrainingSheetButton" text="Import Training Sheet…" onAction="#importTrainingSheet" />
                <Label fx:id="importStatusLabel" styleClass="muted" wrapText="true" managed="false" visible="false" />

                <Label text="Imported Roadmaps" styleClass="dashboard-card-helper" />
                <Label text="Deleting an import only removes its roadmap positions — your solved/in-progress records and any flashcards you've created stay exactly as they are." styleClass="muted" wrapText="true" />
                <Label fx:id="importBatchesEmptyLabel" text="No imports yet." styleClass="muted" wrapText="true" managed="false" visible="false" />
                <VBox fx:id="importBatchesBox" spacing="6" maxWidth="Infinity" />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
