<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.SettingsController">
    <content>
        <VBox spacing="18" styleClass="content" maxWidth="Infinity">
            <VBox spacing="8" styleClass="page-header" maxWidth="Infinity">
                <Label text="Settings" styleClass="page-title" wrapText="true" />
            </VBox>

            <VBox spacing="8" styleClass="panel" maxWidth="Infinity">
                <Label text="Daily Training Intensity" styleClass="section-title" />
                <Label text="Choose how much CodeFit should plan for today's quests and review-session queue." styleClass="muted" wrapText="true" />
                <ChoiceBox fx:id="workloadModeChoiceBox" maxWidth="Infinity" />
                <Label fx:id="workloadModeDetailLabel" styleClass="dashboard-card-helper" wrapText="true" />
            </VBox>
        </VBox>
    </content>
</ScrollPane>
