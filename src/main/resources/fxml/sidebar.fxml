<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<fx:root type="VBox" styleClass="sidebar" spacing="14" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <VBox styleClass="brand-block" spacing="3">
        <Label text="CodeFit" styleClass="sidebar-title" />
        <Label fx:id="subtitleLabel" text="Train your dev memory" styleClass="sidebar-subtitle" />
    </VBox>

    <VBox styleClass="nav-group" spacing="8">
        <Label text="MAIN" styleClass="nav-section-label" />
        <Button fx:id="todayButton" text="Today" onAction="#goToday" maxWidth="Infinity" />
        <Button fx:id="reviewButton" text="Review" onAction="#goReview" maxWidth="Infinity" />
        <Button fx:id="libraryButton" text="Library" onAction="#goLibrary" maxWidth="Infinity" />
        <Button fx:id="progressButton" text="Progress" onAction="#goProgress" maxWidth="Infinity" />
    </VBox>

    <Region VBox.vgrow="ALWAYS" />

    <VBox styleClass="theme-selector-card" spacing="8">
        <Label text="THEME" styleClass="nav-section-label" />
        <ChoiceBox fx:id="themeChoiceBox" maxWidth="Infinity" />
    </VBox>

    <VBox fx:id="footerCard" styleClass="sidebar-footer-card" spacing="4">
        <Label text="Keep it warm" styleClass="sidebar-footer-title" />
        <Label text="Review a few cards today to protect your streak." styleClass="sidebar-footer-text" wrapText="true" />
    </VBox>
</fx:root>
