<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.codefit.ui.Sidebar?>

<BorderPane styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.StatsController">
    <left>
        <Sidebar activePage="stats" />
    </left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
            <content>
                <VBox spacing="18" styleClass="content" maxWidth="Infinity">
                    <VBox spacing="8" styleClass="page-header" maxWidth="Infinity">
                        <Label text="Stats" styleClass="page-title" wrapText="true" />
                        <Label text="Track progress, spot weak areas, and review activity after the performance summaries." styleClass="page-subtitle" wrapText="true" />
                    </VBox>
                    <VBox fx:id="statsEmptyStateBox" spacing="10" styleClass="status-banner" maxWidth="Infinity" visible="false" managed="false">
                        <Label fx:id="statsEmptyStateLabel" wrapText="true" />
                        <Button text="Start a Review" onAction="#goReview" styleClass="action-button" maxWidth="Infinity" />
                    </VBox>
                    <TilePane hgap="18" vgap="18" prefColumns="4" prefTileWidth="180" maxWidth="Infinity" tileAlignment="TOP_LEFT" styleClass="card-tile-grid">
                        <VBox styleClass="stat-card" minWidth="0" maxWidth="Infinity"><Label text="LEVEL" styleClass="stat-label" /><Label fx:id="levelLabel" styleClass="stat-value" wrapText="true" /><ProgressBar fx:id="xpProgressBar" maxWidth="Infinity" /><Label fx:id="xpLabel" styleClass="muted" wrapText="true" /></VBox>
                        <VBox styleClass="stat-card" minWidth="0" maxWidth="Infinity"><Label text="STREAK" styleClass="stat-label" /><Label fx:id="streakLabel" styleClass="stat-value" wrapText="true" /></VBox>
                        <VBox styleClass="stat-card" minWidth="0" maxWidth="Infinity"><Label text="REVIEWS" styleClass="stat-label" /><Label fx:id="totalReviewsLabel" styleClass="stat-value" wrapText="true" /></VBox>
                        <VBox styleClass="stat-card" minWidth="0" maxWidth="Infinity"><Label text="TODAY" styleClass="stat-label" /><Label fx:id="reviewedTodayLabel" styleClass="stat-value accent" wrapText="true" /></VBox>
                        <VBox styleClass="stat-card" minWidth="0" maxWidth="Infinity"><Label text="READINESS SCORE" styleClass="stat-label" /><Label fx:id="readinessScoreLabel" styleClass="stat-value accent" wrapText="true" /><Label text="Blends objective accuracy, timed success, weak-area pressure, and consistency" styleClass="muted" wrapText="true" /></VBox>
                        <VBox styleClass="stat-card" minWidth="0" maxWidth="Infinity"><Label text="TIMED FLUENCY" styleClass="stat-label" /><Label fx:id="timedFluencyLabel" styleClass="stat-value" wrapText="true" /><Label text="Recent answers that were both correct and submitted in time" styleClass="muted" wrapText="true" /></VBox>
                        <VBox styleClass="stat-card" minWidth="0" maxWidth="Infinity"><Label text="WEAK-AREA PRESSURE" styleClass="stat-label" /><Label fx:id="weakAreaPressureLabel" styleClass="stat-value" wrapText="true" /><Label text="Recent Again/Hard scheduling ratings (self-assessed difficulty)" styleClass="muted" wrapText="true" /></VBox>
                        <VBox styleClass="stat-card" minWidth="0" maxWidth="Infinity"><Label text="CONSISTENCY" styleClass="stat-label" /><Label fx:id="consistencyLabel" styleClass="stat-value" wrapText="true" /><Label text="Active days in the last week" styleClass="muted" wrapText="true" /></VBox>
                        <VBox styleClass="stat-card" minWidth="0" maxWidth="Infinity"><Label text="SELF-ASSESSMENT" styleClass="stat-label" /><Label fx:id="subjectiveSelfAssessmentLabel" styleClass="stat-value" wrapText="true" /><Label text="Concept cards self-rated Good/Easy (excluded from objective accuracy)" styleClass="muted" wrapText="true" /></VBox>
                        <VBox styleClass="stat-card" minWidth="0" maxWidth="Infinity"><Label text="CONFIDENCE CALIBRATION" styleClass="stat-label" /><Label fx:id="confidenceCalibrationLabel" styleClass="stat-value" wrapText="true" /><Label text="How often stated confidence (High/Low) matched the actual outcome" styleClass="muted" wrapText="true" /></VBox>
                    </TilePane>
                    <VBox spacing="8" styleClass="panel" maxWidth="Infinity">
                        <Label text="Daily Training Intensity" styleClass="section-title" />
                        <Label text="Choose how much CodeFit should plan for today's quests, dashboard routine, and review-session queue." styleClass="muted" wrapText="true" />
                        <ChoiceBox fx:id="workloadModeChoiceBox" maxWidth="Infinity" />
                        <Label fx:id="workloadModeDetailLabel" styleClass="dashboard-card-helper" wrapText="true" />
                    </VBox>
                    <VBox spacing="8" styleClass="panel" maxWidth="Infinity">
                        <Label text="Weekly Boss Battle" styleClass="section-title" />
                        <Label fx:id="weeklyBossScoreLabel" styleClass="stat-value accent" wrapText="true" />
                        <Label fx:id="weeklyBossWeakAreasLabel" styleClass="muted" wrapText="true" />
                        <Label fx:id="weeklyBossFocusLabel" styleClass="dashboard-card-helper" wrapText="true" />
                        <Button fx:id="weeklyBossButton" text="Start Weekly Boss Battle" onAction="#startWeeklyBossBattle" styleClass="action-button" maxWidth="Infinity" />
                    </VBox>
                    <TilePane hgap="18" vgap="18" prefColumns="2" prefTileWidth="220" maxWidth="Infinity" tileAlignment="TOP_LEFT" styleClass="card-tile-grid">
                        <VBox styleClass="small-card" minWidth="0" maxWidth="Infinity"><Label text="Total Cards" styleClass="stat-label" /><Label fx:id="totalCardsLabel" styleClass="stat-value" wrapText="true" /></VBox>
                        <VBox styleClass="small-card" minWidth="0" maxWidth="Infinity"><Label text="Due Cards" styleClass="stat-label" /><Label fx:id="dueCardsLabel" styleClass="stat-value" wrapText="true" /></VBox>
                    </TilePane>

                    <FlowPane hgap="18" vgap="18" prefWrapLength="760" maxWidth="Infinity" VBox.vgrow="ALWAYS" styleClass="workspace-grid">
                        <VBox spacing="10" styleClass="panel primary-column" minWidth="0" prefWidth="360" maxWidth="Infinity">
                            <Label text="Skill Performance" styleClass="section-title" />
                            <Label text="Accuracy is the share of objectively text-graded reviews with a correct answer for each skill, not the self-selected rating. Self-graded concept cards are excluded from accuracy and shown separately. Weak areas are skills with at least 2 recent reviews and 40% or more AGAIN/HARD scheduling ratings." styleClass="muted" wrapText="true" />
                            <ListView fx:id="skillPerformanceListView" prefHeight="220" VBox.vgrow="ALWAYS" />
                        </VBox>
                        <VBox spacing="10" styleClass="panel primary-column" minWidth="0" prefWidth="360" maxWidth="Infinity">
                            <Label text="Needs Practice" styleClass="section-title" />
                            <Label text="Weak areas prioritize the skills most likely to benefit from review now. Use the action when available to jump straight into due-card practice." styleClass="muted" wrapText="true" />
                            <ListView fx:id="needsPracticeListView" prefHeight="220" VBox.vgrow="ALWAYS" />
                        </VBox>
                    </FlowPane>
                    <VBox spacing="10" styleClass="panel" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                        <Label text="Recent Reviews" styleClass="section-title" />
                        <Label text="Lower-priority activity log: most recent review outcomes and interval changes." styleClass="muted" wrapText="true" />
                        <ListView fx:id="recentReviewsListView" prefHeight="220" VBox.vgrow="ALWAYS" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
