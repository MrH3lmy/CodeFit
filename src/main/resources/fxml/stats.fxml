<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.StatsController">
    <content>
                <VBox spacing="14" styleClass="content" maxWidth="Infinity">
                    <VBox spacing="4" styleClass="page-header" maxWidth="Infinity">
                        <Label text="Progress" styleClass="page-title" wrapText="true" />
                    </VBox>
                    <VBox fx:id="statsEmptyStateBox" spacing="10" styleClass="status-banner" maxWidth="Infinity" visible="false" managed="false">
                        <Label fx:id="statsEmptyStateLabel" wrapText="true" />
                        <Button text="Start a Review" onAction="#goReview" styleClass="action-button" maxWidth="Infinity" />
                    </VBox>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ToggleButton fx:id="overviewTabButton" text="Overview" styleClass="ghost-button" selected="true" />
                        <ToggleButton fx:id="skillsTabButton" text="Skills" styleClass="ghost-button" />
                        <ToggleButton fx:id="activityTabButton" text="Activity" styleClass="ghost-button" />
                    </HBox>

                    <!-- OVERVIEW -->
                    <VBox fx:id="overviewTabPanel" spacing="14" maxWidth="Infinity">
                        <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="14" styleClass="dashboard-signal-strip">
                            <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                <Label text="RETENTION" styleClass="dashboard-card-title" wrapText="true" />
                                <Label fx:id="heroRetentionLabel" text="No signal" styleClass="dashboard-signal-value" wrapText="true" />
                            </VBox>
                            <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                <Label text="MASTERED" styleClass="dashboard-card-title" wrapText="true" />
                                <Label fx:id="heroMasteredLabel" text="0 cards" styleClass="dashboard-signal-value" wrapText="true" />
                            </VBox>
                            <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                <Label text="THIS WEEK" styleClass="dashboard-card-title" wrapText="true" />
                                <Label fx:id="heroThisWeekLabel" text="0 reviews" styleClass="dashboard-signal-value" wrapText="true" />
                            </VBox>
                        </HBox>

                        <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                            <Label text="WEAKEST SKILLS" styleClass="dashboard-card-title" wrapText="true" />
                            <VBox fx:id="weakestSkillsCompactList" spacing="8" maxWidth="Infinity" />
                        </VBox>

                        <TitledPane text="Advanced Metrics" expanded="false" maxWidth="Infinity">
                            <content>
                                <VBox spacing="10" maxWidth="Infinity">
                                    <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="14" styleClass="dashboard-signal-strip">
                                        <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                            <Label text="READINESS SCORE" styleClass="dashboard-card-title" wrapText="true" />
                                            <Label fx:id="readinessScoreLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                        </VBox>
                                        <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                            <Label text="TIMED FLUENCY" styleClass="dashboard-card-title" wrapText="true" />
                                            <Label fx:id="timedFluencyLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                        </VBox>
                                        <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                            <Label text="WEAK-AREA PRESSURE" styleClass="dashboard-card-title" wrapText="true" />
                                            <Label fx:id="weakAreaPressureLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                        </VBox>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="14" styleClass="dashboard-signal-strip">
                                        <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                            <Label text="SELF-ASSESSMENT" styleClass="dashboard-card-title" wrapText="true" />
                                            <Label fx:id="subjectiveSelfAssessmentLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                        </VBox>
                                        <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                            <Label text="CONFIDENCE CALIBRATION" styleClass="dashboard-card-title" wrapText="true" />
                                            <Label fx:id="confidenceCalibrationLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </content>
                        </TitledPane>
                    </VBox>

                    <!-- SKILLS -->
                    <VBox fx:id="skillsTabPanel" spacing="14" maxWidth="Infinity" visible="false" managed="false">
                        <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                            <Label text="MASTERY" styleClass="dashboard-card-title" wrapText="true" />
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="14" styleClass="dashboard-signal-strip">
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="SEEN" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="masterySeenLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="LEARNING" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="masteryLearningLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="MASTERED" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="masteryMasteredLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                            </HBox>
                        </VBox>
                        <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                            <Label text="DIAGNOSTIC GRADUATION" styleClass="dashboard-card-title" wrapText="true" />
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="14" styleClass="dashboard-signal-strip">
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="GRADUATED (ALREADY KNEW IT)" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="graduatedCardsLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="SUSPENDED" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="suspendedCardsLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                            </HBox>
                        </VBox>
                        <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                            <Label text="Skill Performance" styleClass="section-title" />
                            <ListView fx:id="skillPerformanceListView" prefHeight="220" VBox.vgrow="ALWAYS" />
                        </VBox>
                        <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                            <Label text="Needs Practice" styleClass="section-title" />
                            <ListView fx:id="needsPracticeListView" prefHeight="220" VBox.vgrow="ALWAYS" />
                        </VBox>

                        <!-- Transfer assessment: unseen/parameterized scenarios that measure whether a
                             concept can be applied in a new situation, kept visibly separate from
                             normal-review retention stats above (#104). Results here never feed back
                             into flashcard scheduling. -->
                        <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                            <Label text="TRANSFER ASSESSMENT" styleClass="dashboard-card-title" wrapText="true" />
                            <Label text="Unseen weekly scenarios that test applying a concept, not recalling a card's wording. Never affects normal review scheduling." styleClass="dashboard-card-helper" wrapText="true" />
                            <Label fx:id="latestAssessmentSummaryLabel" styleClass="dashboard-signal-value" wrapText="true" />
                            <VBox fx:id="transferSkillBreakdownBox" spacing="6" maxWidth="Infinity" />
                            <Button text="Start Weekly Transfer Assessment" onAction="#goWeeklyAssessment" styleClass="action-button" maxWidth="Infinity" />
                        </VBox>
                    </VBox>

                    <!-- ACTIVITY -->
                    <VBox fx:id="activityTabPanel" spacing="14" maxWidth="Infinity" visible="false" managed="false">
                        <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                            <Label text="CONSISTENCY" styleClass="dashboard-card-title" wrapText="true" />
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="14" styleClass="dashboard-signal-strip">
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="STREAK" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="streakLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="CONSISTENCY" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="consistencyLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Learning efficiency: whether training time is producing durable knowledge,
                             kept separate from the gamification/activity signals above. -->
                        <VBox spacing="10" styleClass="panel" maxWidth="Infinity">
                            <Label text="LEARNING EFFICIENCY" styleClass="dashboard-card-title" wrapText="true" />
                            <Label text="Durable knowledge per training hour, not just activity." styleClass="dashboard-card-helper" wrapText="true" />
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="14" styleClass="dashboard-signal-strip">
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="MASTERED / HOUR" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="efficiencyMasteredPerHourLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="RECALLS / MINUTE" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="efficiencyRecallsPerMinuteLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="RECOVERED MISSES" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="efficiencyRecoveredMissesLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="14" styleClass="dashboard-signal-strip">
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="RETENTION @ 7D" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="retention7DayLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="RETENTION @ 14D" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="retention14DayLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="RETENTION @ 30D+" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="retention30DayLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="14" styleClass="dashboard-signal-strip">
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="CONFIDENCE CALIBRATION" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="efficiencyConfidenceLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                                <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                                    <Label text="TIME ON SUSPENDED CARDS" styleClass="dashboard-card-title" wrapText="true" />
                                    <Label fx:id="suspendedCardTimeLabel" styleClass="dashboard-signal-value" wrapText="true" />
                                </VBox>
                            </HBox>
                            <VBox spacing="4" maxWidth="Infinity">
                                <Label text="TIME BY SKILL" styleClass="dashboard-card-title" wrapText="true" />
                                <Label fx:id="timeBySkillLabel" styleClass="dashboard-card-helper" wrapText="true" />
                            </VBox>
                            <VBox spacing="4" maxWidth="Infinity">
                                <Label text="TIME BY CARD TYPE" styleClass="dashboard-card-title" wrapText="true" />
                                <Label fx:id="timeByCardTypeLabel" styleClass="dashboard-card-helper" wrapText="true" />
                            </VBox>
                        </VBox>

                        <VBox spacing="10" styleClass="panel" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                            <Label text="Recent Reviews" styleClass="section-title" />
                            <ListView fx:id="recentReviewsListView" prefHeight="260" VBox.vgrow="ALWAYS" />
                        </VBox>
                    </VBox>
                </VBox>
    </content>
</ScrollPane>
