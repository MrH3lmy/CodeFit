<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.codefit.controller.SyllabusController">
    <content>
                <VBox alignment="TOP_CENTER" maxWidth="Infinity" spacing="16" styleClass="content" VBox.vgrow="ALWAYS">
                    <VBox maxWidth="Infinity" spacing="12" styleClass="page-header">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Training Syllabus" styleClass="page-title" wrapText="true" HBox.hgrow="ALWAYS" />
                            <Button text="Back" onAction="#goDecks" styleClass="ghost-button" minWidth="60" />
                            <Label text="Ordered roadmap" styleClass="pill" wrapText="true" />
                        </HBox>
                        <Label text="Follow each training path module by module — Java Backend fundamentals and the Advanced Backend Engineering track for senior engineers — with every learning objective linked to its recommended flashcard deck and current mastery-based progress." styleClass="page-subtitle" wrapText="true" />
                    </VBox>

                    <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="14" styleClass="dashboard-signal-strip">
                        <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                            <Label text="MODULES" styleClass="dashboard-card-title" wrapText="true" />
                            <Label fx:id="moduleCountLabel" text="8" styleClass="dashboard-signal-value" wrapText="true" />
                        </VBox>
                        <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                            <Label text="EST. CARDS" styleClass="dashboard-card-title" wrapText="true" />
                            <Label fx:id="cardCountLabel" text="0" styleClass="dashboard-signal-value" wrapText="true" />
                        </VBox>
                        <VBox maxWidth="Infinity" minWidth="0" spacing="5" styleClass="dashboard-signal-item" HBox.hgrow="ALWAYS">
                            <Label text="REVIEWED" styleClass="dashboard-card-title" wrapText="true" />
                            <Label fx:id="progressLabel" text="0%" styleClass="dashboard-signal-value" wrapText="true" />
                        </VBox>
                    </HBox>

                    <VBox maxWidth="Infinity" spacing="10" styleClass="dashboard-card">
                        <Label text="ACTIVE FOCUS" styleClass="dashboard-card-title" wrapText="true" />
                        <Label text="Choose the training path and module that new/stretch cards should mainly come from. Due cards from every module always take priority, and a small share of mature cards from other modules is interleaved so older material doesn't rot." styleClass="dashboard-card-helper" wrapText="true" />
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <ChoiceBox fx:id="activePathChoiceBox" minWidth="220" />
                            <ChoiceBox fx:id="focusModuleChoiceBox" minWidth="220" />
                            <Button text="Set Focus" onAction="#setFocus" styleClass="primary-button" />
                        </HBox>
                        <Label fx:id="focusStatusLabel" styleClass="dashboard-card-helper" wrapText="true" />
                        <Label fx:id="focusRecommendationLabel" styleClass="status-banner" wrapText="true" visible="false" managed="false" />
                    </VBox>

                    <VBox maxWidth="Infinity" spacing="12" styleClass="dashboard-card">
                        <Label text="MODULE ROADMAP" styleClass="dashboard-card-title" wrapText="true" />
                        <ListView fx:id="syllabusListView" prefHeight="520" maxWidth="Infinity" VBox.vgrow="ALWAYS" />
                    </VBox>
                </VBox>
    </content>
</ScrollPane>
